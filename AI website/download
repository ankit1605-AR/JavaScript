import { useState } from 'react';
import { Link } from 'react-router-dom';
import CheckoutForm from '../components/CheckoutForm.jsx';
import { useCart } from '../context/CartContext.jsx';
import { useOrderSubmit } from '../hooks/useOrderSubmit.js';

export default function CheckoutPage() {
  const { lines, subtotal, clearCart } = useCart();
  const { status, submitError, submitOrder, resetOrderStatus } = useOrderSubmit();
  const [orderNumber] = useState(() => Math.floor(1000 + Math.random() * 9000));

  const currency = lines[0]?.currency ?? 'USD';

  if (lines.length === 0 && status !== 'success') {
    return (
      <main className="empty-state">
        <h2>Your bag is empty.</h2>
        <p>Add something from the catalog before checking out.</p>
        <Link to="/" className="btn btn--primary">
          Browse the catalog
        </Link>
      </main>
    );
  }

  async function handleSubmit(orderDetails) {
    await submitOrder({ ...orderDetails, orderNumber });
  }

  function handleStartOver() {
    clearCart();
    resetOrderStatus();
  }

  return (
    <main>
      <h2 className="page-title">Checkout</h2>

      <div className="checkout-layout">
        <div className="order-summary">
          <p className="order-summary__eyebrow">Order Summary</p>
          {lines.map((line) => (
            <div className="order-summary__row" key={line.key}>
              <span>
                {line.name} <span className="order-summary__variant">({line.colorLabel}, {line.sizeLabel})</span> &times;{' '}
                {line.quantity}
              </span>
              <span>${(line.price * line.quantity).toFixed(2)}</span>
            </div>
          ))}
          <div className="order-summary__row order-summary__row--total">
            <span>Total</span>
            <span>${subtotal.toFixed(2)}</span>
          </div>
        </div>

        <div className="checkout-panel">
          <CheckoutForm
            lineItems={lines}
            totalPrice={subtotal}
            currency={currency}
            orderNumber={orderNumber}
            status={status}
            submitError={submitError}
            onSubmit={handleSubmit}
          />
          {status === 'success' ? (
            <button type="button" className="btn btn--ghost btn--block" onClick={handleStartOver}>
              Continue shopping
            </button>
          ) : (
            <Link to="/cart" className="btn btn--ghost btn--block">
              Back to bag
            </Link>
          )}
        </div>
      </div>
    </main>
  );
}
