import ProductCard from '../components/ProductCard.jsx';
import { useProducts } from '../hooks/useProducts.js';

export default function CatalogPage() {
  const { products, isLoading, isDemoData } = useProducts();

  if (isLoading) {
    return (
      <main className="loading-state" aria-live="polite">
        Loading catalog page…
      </main>
    );
  }

  return (
    <main>
      {isDemoData ? (
        <p className="demo-banner" role="note">
          Demo mode: showing sample catalog data. Connect Firebase (see README) to load your own
          products from Firestore.
        </p>
      ) : null}

      <div className="catalog-intro">
        <h2 className="catalog-intro__title">Catalog No. 12</h2>
        <p className="catalog-intro__body">
          Six pieces, reissued true to the original patterns. Pick one to see colors, sizing, and
          stock.
        </p>
      </div>

      <div className="product-grid">
        {products.map((product, index) => (
          <ProductCard key={product.id} product={product} paletteIndex={index} />
        ))}
      </div>
    </main>
  );
}
